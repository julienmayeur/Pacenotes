# ── Interview data: never in git ─────────────────────────────────────────────
# Paths starting with "/" are anchored to the repo root, so they never hit a code package
# (pacenote/clients/) or a test folder (tests/fixtures/clients/).

# Live sessions: transcripts, state, plans, logs
/sessions/

# Real clients: sheets, questionnaires, glossaries, research, people, metrics.
# The committed example is the fictional clients.example/.
/clients/

# The example client stays fictional: only its three seed files are tracked; everything the app
# writes next to them (research, preplan, history, people, metrics, ambassadors, locks, temp files)
# stays local
/clients.example/*/*
!/clients.example/*/client.yaml
!/clients.example/*/glossary.md
!/clients.example/*/questionnaire.yaml

# Potential ambassadors (people named in an interview) are local only, wherever they land
ambassadors.json

# Recordings and transcripts (tests build synthetic ones at run time)
/samples/
*.srt
*.vtt
*.wav
*.m4a
*.mp3
*.aac
*.flac
*.caf
wispr*.txt

# Exports
*.pdf

# ── Secrets and local config ─────────────────────────────────────────────────
.env
.env.*
.envrc
*.pem
*.key

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
.venv/
venv/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# ── Swift helper builds ──────────────────────────────────────────────────────
.build/
*.o

# ── Node (Playwright checks) ─────────────────────────────────────────────────
node_modules/

# ── OS and editors ───────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
